@{
    ViewData["Title"] = "Features";
}

<div class="features-page">

    <section class="features-hero">

        <div class="features-badge">
            ✦ POWERFUL STUDY FEATURES
        </div>

        <h1>
            Everything You Need
            <span>To Study Better</span>
        </h1>

        <p>
            SmartStudyPlannerSystem brings your study plans, tasks,
            reminders and progress together in one organized platform.
        </p>

    </section>


    <section class="features-grid">

        <div class="system-feature-card">

            <div class="system-feature-icon">
                📅
            </div>

            <h2>Smart Study Plans</h2>

            <p>
                Create personalized study plans with subjects, topics,
                dates, study timings and notes.
            </p>

        </div>


        <div class="system-feature-card">

            <div class="system-feature-icon">
                ✅
            </div>

            <h2>Task Management</h2>

            <p>
                Create, edit and delete study tasks while managing
                priorities, deadlines and completion status.
            </p>

        </div>


        <div class="system-feature-card">

            <div class="system-feature-icon">
                🔔
            </div>

            <h2>Smart Reminders</h2>

            <p>
                View upcoming tasks and study plans so important
                academic activities are easier to remember.
            </p>

        </div>


        <div class="system-feature-card">

            <div class="system-feature-icon">
                📊
            </div>

            <h2>Progress Tracking</h2>

            <p>
                Monitor completed and pending tasks through a
                simple and informative dashboard.
            </p>

        </div>


        <div class="system-feature-card">

            <div class="system-feature-icon">
                👨‍🎓
            </div>

            <h2>Student Dashboard</h2>

            <p>
                Students can view their own study plans, tasks,
                reminders and academic progress in one place.
            </p>

        </div>


        <div class="system-feature-card">

            <div class="system-feature-icon">
                🛡️
            </div>

            <h2>Admin Management</h2>

            <p>
                Administrators can monitor registered students,
                study plans and tasks across the system.
            </p>

        </div>

    </section>

</div>