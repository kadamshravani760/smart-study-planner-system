@{
    ViewData["Title"] = "About Us";
}

<div class="about-page">

    <!-- HERO -->
    <section class="about-hero">

        <div class="about-badge">
            ✦ ABOUT SMART STUDY PLANNER
        </div>

        <h1>
            Study Smarter.
            <span>Achieve More.</span>
        </h1>

        <p>
            SmartStudyPlannerSystem is a student-focused platform designed
            to make academic planning simple, organized and effective.
        </p>

    </section>


    <!-- ABOUT CARDS -->
    <section class="about-content">

        <!-- MISSION -->
        <div class="about-card">

            <div class="about-card-icon">
                🎯
            </div>

            <h2>Our Mission</h2>

            <p>
                Our mission is to help students organize their study routines,
                manage academic tasks and stay focused on their learning goals
                through one simple and intelligent platform.
            </p>

        </div>


        <!-- VISION -->
        <div class="about-card">

            <div class="about-card-icon">
                💡
            </div>

            <h2>Our Vision</h2>

            <p>
                We aim to create a better digital study experience where
                students can plan their schedules, monitor progress and
                complete their academic activities with confidence.
            </p>

        </div>


        <!-- WHAT WE PROVIDE -->
        <div class="about-card">

            <div class="about-card-icon">
                📚
            </div>

            <h2>What We Provide</h2>

            <p>
                The system provides study planning, task management,
                reminders, progress tracking and personalized student
                dashboards in one organized environment.
            </p>

        </div>

    </section>


    <!-- HIGHLIGHT -->
    <section class="about-highlight">

        <div class="about-highlight-content">

            <span>SMART STUDY PLANNER</span>

            <h2>
                Everything you need to organize your studies.
            </h2>

            <p>
                Plan your studies, manage your tasks, track your progress
                and stay prepared for your academic goals.
            </p>

        </div>

        <div class="about-highlight-icon">
            🎓
        </div>

    </section>

</div>